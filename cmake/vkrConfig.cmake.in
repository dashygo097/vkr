@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(APPLE)
  find_dependency(Vulkan COMPONENTS MoltenVK shaderc_combined)
else()
  find_dependency(Vulkan COMPONENTS shaderc_combined)
endif()

set(vkr_VERSION "@PROJECT_VERSION@")
set(vkr_HAS_SLANG @HAS_SLANG@)
if(vkr_HAS_SLANG)
  get_filename_component(_vkr_vulkan_library_dir "${Vulkan_LIBRARY}" DIRECTORY)
  find_dependency(slang CONFIG
    HINTS "${_vkr_vulkan_library_dir}/cmake/slang"
  )
  unset(_vkr_vulkan_library_dir)
endif()

if(UNIX AND NOT APPLE)
  find_dependency(SPIRV-Tools CONFIG)
  find_dependency(SPIRV-Tools-opt CONFIG)
  find_dependency(glslang CONFIG)
endif()
if("@SPDLOG_FMT_EXTERNAL@" OR "@SPDLOG_FMT_EXTERNAL_HO@")
  find_dependency(fmt CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/vkrTargets.cmake")
include("${PROJECT_BINARY_DIR}/config.cmake" OPTIONAL)
include("${CMAKE_CURRENT_LIST_DIR}/config.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/VkApp.cmake")

check_required_components(vkr)
